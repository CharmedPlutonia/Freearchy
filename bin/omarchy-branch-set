#!/bin/bash

# omarchy:summary=Switch the Freearchy git branch between main and testing
# omarchy:args=<main|testing>

case "${1:-main}" in
  testing | nightly | freearchy-nightly) branch="testing" ;;
  main | master | beta) branch="main" ;;
  *)
    echo "Error: Refusing to switch to '$1'. Choose main or testing."
    exit 1
    ;;
esac

git -C "$OMARCHY_PATH" remote set-url origin https://github.com/CharmedPlutonia/Freearchy.git
git -C "$OMARCHY_PATH" fetch origin "$branch"
git -C "$OMARCHY_PATH" switch -C "$branch" "origin/$branch"
mkdir -p "${HOME}/.config/omarchy"
printf '%s\n' "$branch" >"${HOME}/.config/omarchy/channel"
echo "Update channel: $branch"
