{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;32;223;241"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "Freearchy"
    },
    {
      "type": "command",
      "key": "Theme",
      "keyColor": "38;2;32;223;241",
      "text": "omarchy-theme-current"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "38;2;32;223;241"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "38;2;32;223;241"
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "38;2;32;223;241"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "38;2;32;223;241"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci",
      "keyColor": "38;2;32;223;241"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "38;2;32;223;241"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "38;2;32;223;241"
    },
    {
      "type": "uptime",
      "key": "Up",
      "keyColor": "38;2;32;223;241"
    }
  ]
}
