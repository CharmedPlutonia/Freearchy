#!/bin/bash

# omarchy:summary=Launch Steam at the current display scale instead of the old 2x default

scale="${GDK_SCALE:-1}"
# GTK only honors whole numbers; Steam's desktop UI scale matches that.
case "$scale" in
  ''|*[!0-9.]*) scale=1 ;;
esac

export GDK_SCALE="$scale"
export GDK_DPI_SCALE=1
export QT_SCALE_FACTOR="$scale"
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export STEAM_FORCE_DESKTOPUI_SCALING="$scale"

if omarchy-cmd-missing steam; then
  echo "Steam is not installed. Install it from the menu under Install > Steam."
  exit 1
fi

exec steam -forcedesktopscaling "$scale" "$@"
