#!/bin/bash

# omarchy:summary=Report whether Freearchy 1 beta has new commits

fork="https://github.com/CharmedPlutonia/Freearchy.git"
branch="$(omarchy-version-channel)"
[[ $branch == "testing" ]] || branch="main"

git -C "$OMARCHY_PATH" remote set-url origin "$fork"
if ! git -C "$OMARCHY_PATH" fetch --quiet origin "$branch"; then
  echo "Error: Could not reach the Freearchy repo."
  exit 1
fi

local_rev=$(git -C "$OMARCHY_PATH" rev-parse HEAD)
remote_rev=$(git -C "$OMARCHY_PATH" rev-parse "origin/$branch")

if [[ $local_rev != $remote_rev ]]; then
  echo "Freearchy $branch update available"
  exit 0
fi

echo "Freearchy $branch is up to date"
exit 1
