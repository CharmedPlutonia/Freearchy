#!/bin/bash

# omarchy:summary=Update Freearchy from main or testing
# omarchy:args=<main|testing>

set -e

case "${1:-}" in
  "" ) branch="$(omarchy-version-channel)" ;;
  testing | nightly | freearchy-nightly) branch="testing" ;;
  main | master | beta) branch="main" ;;
  *)
    echo "Error: Refusing to update from '$1'."
    echo "Choose main or testing. Omarchy channels are not used."
    exit 1
    ;;
esac

omarchy-snapshot create || (($? == 127))
omarchy-channel-set "$branch"
