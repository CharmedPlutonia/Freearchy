#!/bin/bash

# omarchy:summary=Remove any leftover passwordless sudo grant. Enabling it is not supported.
# omarchy:requires-sudo=true

shopt -s nullglob
removed=0
for grant in /etc/sudoers.d/99-omarchy-nopasswd-*; do
  sudo rm -f "$grant"
  removed=1
done
sudo systemctl stop "omarchy-nopasswd-expire-${USER}.timer" 2>/dev/null || true
sudo systemctl reset-failed "omarchy-nopasswd-expire-${USER}.service" 2>/dev/null || true

if ((removed)); then
  echo "Removed passwordless sudo."
else
  echo "Passwordless sudo is disabled and cannot be turned on."
fi
