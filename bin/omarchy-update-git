#!/bin/bash

# omarchy:summary=Pull the latest Freearchy 1 beta git changes

set -e

fork="https://github.com/CharmedPlutonia/Freearchy.git"
branch="$(omarchy-version-channel)"
[[ $branch == "testing" ]] || branch="main"

echo -e "\033[38;2;32;223;241mUpdate Freearchy from $branch\033[0m"

omarchy-update-time

hyprctl keyword debug:suppress_errors true &>/dev/null || true

git -C "$OMARCHY_PATH" remote set-url origin "$fork"
git -C "$OMARCHY_PATH" fetch origin "$branch"

if [[ $(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref HEAD) != "$branch" ]]; then
  git -C "$OMARCHY_PATH" checkout -B "$branch" "origin/$branch"
else
  git -C "$OMARCHY_PATH" pull --autostash origin "$branch"
fi

git -C "$OMARCHY_PATH" --no-pager diff --check || git -C "$OMARCHY_PATH" reset --merge

hyprctl reload &>/dev/null || true
