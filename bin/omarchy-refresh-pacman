#!/bin/bash

# omarchy:summary=Point pacman at official Arch repositories only, then update packages.
# omarchy:requires-sudo=true

sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak

sudo cp -f "$OMARCHY_PATH/default/pacman/pacman-stable.conf" /etc/pacman.conf

if grep -q 'omarchy.org' /etc/pacman.d/mirrorlist 2>/dev/null; then
  echo "Replacing Omarchy package mirror with the official Arch geo mirror"
  echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' | sudo tee /etc/pacman.d/mirrorlist >/dev/null
fi

sudo pacman -Syyu --noconfirm
