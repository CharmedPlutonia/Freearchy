#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking Flathub applications to install.
# omarchy:requires-sudo=true

# Same picker as the Arch and AUR installers. Apps install for this user only,
# matching Freearchy main, so they do not need a system-wide Flatpak remote.

omarchy-pkg-add flatpak
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

fzf_args=(
  --multi
  --preview 'flatpak remote-info --user flathub {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

echo "Loading Flathub..."
pkg_names=$(flatpak remote-ls --user --columns=application flathub | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  echo "$pkg_names" | tr '\n' ' ' | xargs flatpak install -y --user flathub
  update-desktop-database ~/.local/share/applications 2>/dev/null || true
  omarchy-show-done
fi
