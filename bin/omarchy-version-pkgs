#!/bin/bash

# omarchy:summary=Print when system packages were last upgraded

line=$(tac /var/log/pacman.log 2>/dev/null | grep -m 1 -E 'upgraded|installed' || true)
if [[ -z $line ]]; then
  echo "unknown"
  exit 0
fi
stamp=$(sed -E 's/\[([^]]+)\].*/\1/' <<<"$line")
date -d "$stamp" "+%A, %B %d %Y at %H:%M" 2>/dev/null || echo "$stamp"
