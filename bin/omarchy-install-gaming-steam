#!/bin/bash

# omarchy:summary=Install Steam and graphics drivers selected for this system
# omarchy:requires-sudo=true

set -e

echo "Installing Steam..."
omarchy-pkg-add steam
omarchy-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

if [[ -f $OMARCHY_PATH/applications/steam.desktop ]]; then
  cp "$OMARCHY_PATH/applications/steam.desktop" "$HOME/.local/share/applications/steam.desktop"
  update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
fi

setsid uwsm-app -- omarchy-launch-steam >/dev/null 2>&1 &
