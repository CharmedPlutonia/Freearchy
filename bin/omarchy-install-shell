#!/bin/bash

# omarchy:summary=Install Fish or zsh with Oh My Zsh and apply the current Freearchy theme
# omarchy:args=<fish|zsh>
# omarchy:examples=omarchy install shell fish | omarchy install shell zsh
# omarchy:requires-sudo=true

set -euo pipefail

install_fish() {
  echo "Installing Fish..."
  omarchy-pkg-add fish

  if ! command -v fish >/dev/null; then
    echo "Fish installed according to pacman, but it is not on PATH." >&2
    exit 1
  fi

  mkdir -p ~/.config/fish
  local rc="$OMARCHY_PATH/default/fish/rc.fish"
  local config=~/.config/fish/config.fish
  if [[ ! -f $config ]]; then
    printf '# Freearchy fish entrypoint. Add personal config below the source line.\nsource %s\n' "$rc" >"$config"
  elif ! grep -q "default/fish/rc.fish" "$config"; then
    printf '\n# Freearchy fish defaults\nsource %s\n' "$rc" >>"$config"
  fi

  omarchy-theme-set-shell || true
  omarchy-default-shell fish
  echo ""
  echo "Fish is installed and set as the login shell. Open a new terminal to use it."
}

install_zsh() {
  echo "Installing zsh and Oh My Zsh..."
  omarchy-pkg-add zsh

  if ! command -v zsh >/dev/null; then
    echo "zsh installed according to pacman, but it is not on PATH." >&2
    exit 1
  fi

  if [[ ! -d $HOME/.oh-my-zsh ]]; then
    git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"
  fi

  mkdir -p "$HOME/.oh-my-zsh/custom/themes"

  local zshrc_src="$OMARCHY_PATH/default/zshrc"
  [[ -f $zshrc_src ]] || zshrc_src="$OMARCHY_PATH/default/zsh/zshrc"
  local rc="$OMARCHY_PATH/default/zsh/rc"

  if [[ ! -f $HOME/.zshrc ]]; then
    if [[ -f $zshrc_src ]]; then
      cp "$zshrc_src" "$HOME/.zshrc"
    else
      printf '# Freearchy zsh entrypoint\nsource %s\n' "$rc" >"$HOME/.zshrc"
    fi
  elif ! grep -q "default/zsh" "$HOME/.zshrc"; then
    printf '\n# Freearchy zsh defaults\nsource %s\n' "$rc" >>"$HOME/.zshrc"
  fi

  omarchy-theme-set-shell || true
  omarchy-default-shell zsh
  echo ""
  echo "zsh with Oh My Zsh is installed and set as the login shell. Open a new terminal to use it."
}

case ${1:-} in
fish)
  install_fish
  ;;
zsh | ohmyzsh | oh-my-zsh)
  install_zsh
  ;;
*)
  echo "Usage: omarchy-install-shell <fish|zsh>"
  exit 1
  ;;
esac
